# Database
DATABASE_URL=postgresql+asyncpg://docuser:docpass@localhost:5432/docservice

# Redis (ARQ)
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage
MAX_FILE_SIZE_BYTES=104857600

# OCR
OCR_LANGUAGE=eng
MAX_OCR_PAGES=50
MAX_OCR_BATCH_FILES=20
MAX_MCP_FILE_SIZE_BYTES=8388608
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# PDF optimization (pikepdf/qpdf)
ENABLE_PDF_OPTIMIZE=true

# Compression
DEFAULT_COMPRESSION_LEVEL=6

# HTTP Basic credentials (set both before starting the API)
API_KEY=
API_SECRET=

# Console login (separate from the API credentials)
UI_USERNAME=admin
UI_PASSWORD=
UI_SESSION_SECRET=
